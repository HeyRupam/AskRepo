# ---------------------------------------------------------------
# AskRepo — Template. Copy to .env and fill in real values.
# Read by: docker-compose.yaml (automatically) and the Spring
# backend (via spring.config.import in application.properties).
# ---------------------------------------------------------------

# --- Postgres (docker-compose) ---
POSTGRES_USER=askrepo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=askrepo

# --- Datasource (backend) ---
DB_URL=jdbc:postgresql://localhost:5432/askrepo
DB_USERNAME=askrepo
DB_PASSWORD=change-me

# --- OpenAI-compatible API (OpenRouter key) ---
OPENAI_API_KEY=sk-your-openai-or-openrouter-key

# --- GitHub OAuth app ---
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# --- Encryption of stored GitHub tokens (at rest) ---
# Changing either value makes already-stored tokens undecryptable.
# SALT must be valid hex.
TOKEN_ENCRYPTOR_PASSWORD=generate-a-long-random-passphrase
TOKEN_ENCRYPTOR_SALT=generate-with-openssl-rand-hex-14

# --- Frontend origins ---
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173
